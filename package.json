    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "npm-build-zip": "^2.0.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@extend-chrome/storage": "^1.5.0",
    "daisyui": "^5.7.20",
    "fflate": "^0.8.3",
