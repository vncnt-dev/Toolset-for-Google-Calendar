{
  "name": "gcalendar-tools",
  "version": "1.7.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch": "npm run clean && concurrently \"vite build --mode development --watch\" \"vite build -c vite.config.content.ts --mode development --watch\"",
    "build": "npm run clean && vite build && vite build -c vite.config.content.ts",
    "pack": "node setVersion.js && npm run build && npm-build-zip --src dist --name gcalendar-tools",
    "clean": "rimraf dist",
    "check-ts": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "npm-build-zip": "^2.0.1",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@extend-chrome/storage": "^1.5.0",
    "daisyui": "^5.7.42",
    "fflate": "^0.8.3",
    "ical.js": "^2.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-toastify": "^11.1.0"
  }
}