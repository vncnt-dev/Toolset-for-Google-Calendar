  "main": "index.js",
  "scripts": {
    "watch": "npm run clean && concurrently \"vite build --mode development --watch\" \"vite build -c vite.config.content.ts --mode development --watch\"",
    "build": "npm run clean && vite build && vite build -c vite.config.content.ts",
    "pack": "node setVersion.js && npm run build && npm-build-zip --src dist --name gcalendar-tools",
    "clean": "rimraf dist",
    "check-ts": "tsc --noEmit"
  },
