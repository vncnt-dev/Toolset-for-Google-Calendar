{
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "types": ["node", "chrome"],
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src"]
}